CONFIG_IDF_TARGET="esp32s3"

# Bluetooth: LE controller only, exposed to the app through VHCI
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ONLY=y
CONFIG_BT_CTRL_HCI_MODE_VHCI=y

# TinyUSB Bluetooth HCI class (6 ISO alternate settings, as on standard USB BT radios)
CONFIG_TINYUSB_BTH_ENABLED=y
CONFIG_TINYUSB_BTH_ISO_ALT_COUNT=6
CONFIG_TINYUSB_DEBUG_LEVEL=1
CONFIG_TINYUSB_SUSPEND_CALLBACK=y
CONFIG_TINYUSB_RESUME_CALLBACK=y

# Logging goes to UART0 (the UART/USB-serial bridge port of the DevKitC)
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600
CONFIG_LOG_DEFAULT_LEVEL_DEBUG=y
CONFIG_LOG_MAXIMUM_LEVEL_VERBOSE=y

CONFIG_FREERTOS_HZ=1000
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
